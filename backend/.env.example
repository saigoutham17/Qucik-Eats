# Quick Eats Backend Configuration
PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quick-eats?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Upstash Redis Caching
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Image Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vercel Cron Security
CRON_SECRET=your_random_cron_secret_string

# App URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
RIDER_URL=http://localhost:5175
SUPERADMIN_URL=http://localhost:5176
